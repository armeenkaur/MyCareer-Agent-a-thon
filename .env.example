OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
HOST=0.0.0.0
PORT=5050
# SQLite file — survives app restarts. Override path if needed.
# MYCAREER_DATABASE_PATH=/absolute/path/to/mycareer.db
# All ZM/RD/employee/feedback phases open on boot (set 0 for admin-gated phases).
OPEN_ALL_PHASES_BY_DEFAULT=1
AZURE_OPENAI_API_KEY=your_azure_voice_live_api_key_here
AZURE_VOICE_LIVE_URL=wss://centralindia.api.cognitive.microsoft.com/voice-live/realtime?api-version=2025-05-01-preview&model=gpt-realtime-2025-08-28
# Female OpenAI voice (shimmer) — reliable on gpt-realtime. Avoid male alloy default.
AZURE_VOICE_LIVE_VOICE=shimmer
AZURE_VOICE_LIVE_VOICE_TYPE=openai
AZURE_VOICE_LIVE_VOICE_FALLBACK=coral
AZURE_VOICE_LIVE_VOICE_FALLBACK_TYPE=openai
# Browser PCM playback Hz (Voice Live output is typically 24000; 16000 sounds slow/low)
VOICE_PLAYBACK_SAMPLE_RATE=24000
# Mic capture → Azure input_audio_sampling_rate
VOICE_INPUT_SAMPLE_RATE=16000
# Optional Hotels Diya HD (azure-standard) with pitch/rate set in code:
# AZURE_VOICE_LIVE_VOICE=en-IN-Diya:DragonHDLatestNeural
# AZURE_VOICE_LIVE_VOICE_TYPE=azure-standard
# AZURE_VOICE_LIVE_VOICE_FALLBACK=en-US-AvaNeural
# AZURE_VOICE_LIVE_VOICE_FALLBACK_TYPE=azure-standard
